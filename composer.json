{
    "name": "simple-as-fuck/laravel-lock",
    "description": "Laravel integration for symfony/lock.",
    "require": {
        "php": "^8.2",
        "symfony/lock": "^5.4.7|^6.0.7|^7.0",
        "illuminate/support": "^8.0|^9.0|^10.0|^11.0|^12.0",
        "illuminate/contracts": "^8.0|^9.0|^10.0|^11.0|^12.0",
        "illuminate/database": "^8.0|^9.0|^10.0|^11.0|^12.0",
        "simple-as-fuck/php-validator": "^0.6.0|^0.7.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "spaze/phpstan-disallowed-calls": "^4.5"
    },
    "autoload": {
        "psr-4": {"SimpleAsFuck\\LaravelLock\\": "src/"}
    },
    "extra": {
        "laravel": {
            "providers": [
                "SimpleAsFuck\\LaravelLock\\Provider\\PackageProvider"
            ]
        }
    }
}
